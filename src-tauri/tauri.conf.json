{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carnet",
  "version": "0.1.0",
  "identifier": "fr.carnet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carnet",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' carnet-asset: http://carnet-asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' carnet-asset: http://carnet-asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  }
}
